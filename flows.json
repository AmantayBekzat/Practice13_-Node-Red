        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "{\"available\": false, \"reasonCode\": \"INVALID_DURATION\", \"message\": \"Duration must be a whole number from 1 to 120 minutes.\"}",
        "tot": "json"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
